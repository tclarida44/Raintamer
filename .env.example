# Set when the production domain is live; used by metadataBase, sitemap, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://raintamer.com

# Mapbox token, optional. The current homepage map is custom SVG and does not
# require Mapbox. If a future iteration swaps in a Mapbox-based interactive
# street map (per the brief), add the token here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Quote form destination. Wire to a CRM webhook, Resend/Postmark, or Slack
# incoming webhook. The /api/quote handler is the integration point.
QUOTE_WEBHOOK_URL=
